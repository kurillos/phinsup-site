---
import Layout from '../layouts/BaseLayout.astro';
import players from '../data/roster.json';

// Generic silhouette shown when a player's official headshot fails to load
// (common for recent UDFA signings / rookies without an ESPN photo yet).
const FALLBACK_IMG = "data:image/svg+xml;utf8," + encodeURIComponent(`
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200">
  <rect width="200" height="200" fill="#e5e7eb"/>
  <circle cx="100" cy="78" r="38" fill="#9ca3af"/>
  <path d="M30 190 C30 140 60 118 100 118 C140 118 170 140 170 190 Z" fill="#9ca3af"/>
</svg>
`);

const UNITS = [
  {
    key: 'offense',
    label: 'Offense',
    color: 'miami-aqua',
    roles: ['QB', 'RB', 'WR1', 'WR2', 'WR3', 'TE', 'LT', 'LG', 'C', 'RG', 'RT'],
  },
  {
    key: 'defense',
    label: 'Défense',
    color: 'miami-orange',
    roles: ['LDE', 'LDT', 'RDT', 'RDE', 'WLB', 'MLB', 'SLB', 'LCB', 'SS', 'FS', 'RCB', 'NB'],
  },
  {
    key: 'special',
    label: 'Équipes Spéciales',
    color: 'gray-400',
    roles: ['PK', 'P', 'LS'],
  },
];

function playersForRole(role: string) {
  return players
    .filter((p: any) => p.role === role)
    .sort((a: any, b: any) => a.depth - b.depth);
}
---

<Layout title="Roster 2026 - The Phin Side">
  <main class="max-w-7xl mx-auto py-12 px-6">

    <div class="mb-12">
      <h1 class="text-5xl font-[Oswald] font-black italic uppercase text-miami-aqua tracking-tighter">
        Effectif <span class="text-miami-orange">2026</span>
      </h1>
    </div>

    <div class="flex flex-col gap-6" id="roster-accordion">
      {UNITS.map((unit) => (
        <details class="unit-block rounded-2xl overflow-hidden border border-gray-200 shadow-sm" data-unit={unit.key}>
          <summary class={`unit-summary bg-${unit.color}`}>
            <span class="font-[Oswald] text-3xl font-black italic uppercase text-white tracking-tight">{unit.label}</span>
            <span class="chevron text-white text-2xl">⌄</span>
          </summary>

          <div class="unit-content bg-gray-50 px-6 py-8">
            {unit.roles.map((role) => {
              const rolePlayers = playersForRole(role);
              if (rolePlayers.length === 0) return null;
              return (
                <div class="role-block mb-10 last:mb-0">
                  <h3 class={`role-title font-[Oswald] text-xl font-bold italic uppercase mb-4 pb-2 border-b-2 border-${unit.color} text-gray-800`}>
                    {role}
                  </h3>
                  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
                    {rolePlayers.map((player: any) => {
                      const isOffense = player.unit === 'offense';
                      const isDefense = player.unit === 'defense';
                      const themeColor = isOffense ? 'border-miami-aqua' : (isDefense ? 'border-miami-orange' : 'border-gray-400');
                      const themeBg = isOffense ? 'bg-miami-aqua' : (isDefense ? 'bg-miami-orange' : 'bg-gray-400');
                      const themeText = isOffense ? 'text-miami-aqua' : (isDefense ? 'text-miami-orange' : 'text-gray-400');
                      const label2 = player.stats.label2 ?? 'Yards';
                      const label3 = player.stats.label3 ?? 'TDs';

                      return (
                        <div class="player-card h-120">
                          <div class="flip-card-inner relative w-full h-full duration-700 preserve-3d cursor-pointer group">

                            <div class={`absolute inset-0 backface-hidden rounded-2xl shadow-xl bg-white border-b-8 ${themeColor} overflow-hidden`}>
                              <div class="relative h-3/4 bg-gray-100 flex items-center justify-center overflow-hidden">
                                <img
                                  src={player.image}
                                  alt={player.name}
                                  class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500"
                                  onerror={`this.onerror=null; this.src='${FALLBACK_IMG}'; this.classList.add('fallback-img');`}
                                />
                                <div class={`absolute top-4 left-4 ${themeBg} text-white font-[Oswald] font-bold text-3xl px-3 py-1 rounded shadow-lg italic`}>#{player.number}</div>
                                <div class="absolute top-4 right-4 bg-black/60 text-white font-[Oswald] font-bold text-xs px-2 py-1 rounded uppercase italic">{player.role} {player.depth > 1 ? `#${player.depth}` : ''}</div>
                              </div>
                              <div class="p-5">
                                <h3 class="font-[Oswald] font-bold text-2xl uppercase italic text-gray-900 leading-tight">{player.name}</h3>
                                <p class={`${themeText} font-black tracking-widest text-[10px] uppercase mt-1`}>{player.position} | {player.college}</p>
                              </div>
                            </div>

                            <div class={`absolute inset-0 backface-hidden rotate-y-180 rounded-2xl shadow-2xl ${themeBg} text-white p-6 flex flex-col justify-between border-4 border-white/10`}>
                              <div>
                                <div class="flex justify-between items-start border-b border-white/20 pb-3 mb-4">
                                  <h3 class="font-[Oswald] text-3xl uppercase italic leading-none">{player.name}</h3>
                                  <span class="font-[Oswald] text-2xl opacity-50">#{player.number}</span>
                                </div>
                                <div class="grid grid-cols-3 gap-2 text-center mb-6">
                                  <div class="bg-white/10 p-2 rounded">
                                    <p class="text-[10px] uppercase opacity-70 font-bold">{player.stats.label}</p>
                                    <p class="text-xl font-black">{player.stats.val1}</p>
                                  </div>
                                  <div class="bg-white/10 p-2 rounded border-x border-white/10">
                                    <p class="text-[10px] uppercase opacity-70 font-bold">{label2}</p>
                                    <p class="text-xl font-black">{player.stats.val2}</p>
                                  </div>
                                  <div class="bg-white/10 p-2 rounded">
                                    <p class="text-[10px] uppercase opacity-70 font-bold">{label3}</p>
                                    <p class="text-xl font-black">{player.stats.val3}</p>
                                  </div>
                                </div>
                                <p class="text-sm italic opacity-90">"{player.bio}"</p>
                              </div>
                            </div>

                          </div>
                        </div>
                      )
                    })}
                  </div>
                </div>
              )
            })}
          </div>
        </details>
      ))}
    </div>
  </main>
</Layout>

<style>
  .perspective-1000 { perspective: 1000px; }
  .preserve-3d { transform-style: preserve-3d; }
  .backface-hidden { backface-visibility: hidden; }
  .rotate-y-180 { transform: rotateY(180deg); }
  .flip-card-inner.is-flipped { transform: rotateY(180deg); }
  .fallback-img { object-fit: contain !important; padding: 1.5rem; opacity: 0.9; }

  .unit-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 2rem;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .unit-summary::-webkit-details-marker { display: none; }
  .unit-summary::marker { content: ''; }

  .chevron {
    transition: transform 0.3s ease;
    font-weight: 900;
  }
  details[open] > .unit-summary .chevron {
    transform: rotate(180deg);
  }

  .unit-content {
    animation: fadeIn 0.3s ease;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  const initRoster = () => {
    document.querySelectorAll('.flip-card-inner').forEach(card => {
      card.addEventListener('click', () => card.classList.toggle('is-flipped'));
    });
  };

  initRoster();
  document.addEventListener('astro:after-swap', initRoster);
</script>
