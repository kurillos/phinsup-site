---
import { getCollection } from 'astro:content';

const tousEvenements = await getCollection('evenements', ({ data }) => !data.isDraft);
const maintenant = new Date();

const prochains = tousEvenements
  .filter((e) => new Date(e.data.eventDate) >= maintenant)
  .sort((a, b) => new Date(a.data.eventDate).getTime() - new Date(b.data.eventDate).getTime())
  .slice(0, 4);
---

<div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 border-t-4 border-miami-aqua">
  <div class="flex items-center justify-between mb-4">
    <h3 class="font-[Oswald] text-miami-blue uppercase italic text-xl tracking-wider font-bold">
      Événements 🐬
    </h3>
  </div>

  {prochains.length === 0 ? (
    <p class="text-gray-400 text-xs italic">Aucun événement prévu pour le moment.</p>
  ) : (
    <ul class="divide-y divide-gray-100">
      {prochains.map((e) => (
        <li class="py-3 first:pt-0 last:pb-0 flex flex-col gap-1">
          <span class="self-start text-[10px] font-black uppercase px-2 py-0.5 rounded-full bg-miami-aqua/10 text-miami-aqua italic">
            {e.data.eventType}
          </span>
          <strong class="text-slate-800 text-sm font-bold font-[Oswald] uppercase leading-tight mt-1">
            {e.data.title}
          </strong>
          <span class="text-xs text-gray-500 font-medium">
            📅 {new Date(e.data.eventDate).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit' })}
          </span>
          {e.data.location && (
            <span class="text-xs text-gray-500">📍 {e.data.location}</span>
          )}
          {e.data.link && (
            <a href={e.data.link} target="_blank" rel="noopener" class="text-xs text-miami-orange font-bold hover:underline mt-1 inline-block">
              Rejoindre →
            </a>
          )}
        </li>
      ))}
    </ul>
  )}
</div>
